[Unit]
Description=CoverGuide Celery worker
Requires=coverguide-infra.service omniroute.service
After=coverguide-infra.service omniroute.service

[Service]
Type=simple
WorkingDirectory=/home/akhilesh/Projects/health-insurance-agent
EnvironmentFile=/home/akhilesh/Projects/health-insurance-agent/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/akhilesh/Projects/health-insurance-agent/.venv/bin/celery --workdir backend -A config worker --loglevel=INFO --concurrency=1 --queues=celery,conversation,documents --hostname=coverguide@%%h
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
UMask=0077
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/akhilesh/Projects/health-insurance-agent/data
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
