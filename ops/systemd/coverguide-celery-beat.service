[Unit]
Description=CoverGuide Celery beat scheduler
Requires=coverguide-infra.service omniroute.service
After=coverguide-infra.service omniroute.service

[Service]
Type=simple
WorkingDirectory=/home/akhilesh/Projects/health-insurance-agent
EnvironmentFile=/home/akhilesh/Projects/health-insurance-agent/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/akhilesh/Projects/health-insurance-agent/.venv/bin/celery --workdir backend -A config beat --loglevel=INFO --schedule=/home/akhilesh/.local/state/coverguide/celerybeat-schedule
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/akhilesh/.local/state/coverguide
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
