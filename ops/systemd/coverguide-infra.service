[Unit]
Description=CoverGuide PostgreSQL, Redis, and nginx
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/akhilesh/Projects/health-insurance-agent
ExecStart=/usr/bin/docker compose -p coverguide-v2-closeout up -d --no-build postgres18 redis nginx
ExecStartPost=/home/akhilesh/Projects/health-insurance-agent/scripts/check_coverguide_infra.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
UMask=0077
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
