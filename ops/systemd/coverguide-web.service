[Unit]
Description=CoverGuide Django ASGI backend
Requires=coverguide-infra.service omniroute.service
After=coverguide-infra.service omniroute.service

[Service]
Type=simple
WorkingDirectory=/home/akhilesh/Projects/health-insurance-agent
EnvironmentFile=/home/akhilesh/Projects/health-insurance-agent/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/home/akhilesh/Projects/health-insurance-agent/.venv/bin/python backend/manage.py migrate --check
ExecStart=/home/akhilesh/Projects/health-insurance-agent/.venv/bin/uvicorn config.asgi:application --app-dir backend --host 127.0.0.1 --port 8018
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
UMask=0077
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/akhilesh/Projects/health-insurance-agent/data
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
