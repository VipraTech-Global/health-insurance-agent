DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
POSTGRES_DB=health_adviser
POSTGRES_USER=health_adviser
POSTGRES_PASSWORD=health_adviser_local
POSTGRES_HOST=127.0.0.1
# PostgreSQL 18 replacement. Set 55448 to rehearse rollback to the untouched v1 volume.
POSTGRES_PORT=55449
# Set POSTGRES_PORT=55448 and COVERGUIDE_V2_ENABLED=0 for the untouched pilot rollback.
COVERGUIDE_V2_ENABLED=1
COVERGUIDE_DOCLING_ARTIFACTS_PATH=
COVERGUIDE_TESSERACT_PATH=
COVERGUIDE_EMBEDDING_MODEL_PATH=
COVERGUIDE_EMBEDDING_QUALIFICATION_PATH=
REDIS_URL=redis://127.0.0.1:6398/8
DATA_ROOT=/absolute/path/to/health-insurance-agent/data
USE_X_ACCEL_REDIRECT=1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_HSTS_SECONDS=0

# CoverGuide reuses the laptop-wide Job-In CLIProxyAPI instance. Server only.
AI_RELAY_BASE_URL=http://127.0.0.1:8317
AI_RELAY_API_KEY=
AI_RELAY_MANAGEMENT_KEY=
AI_RELAY_STATE_DIR=/absolute/path/to/relay-accounts

# Optional OmniRoute gateway (self-hosted, loopback only; server only). Leave disabled unless the
# gateway key has request logging off and prompt compression off, then set the confirmation to 1.
# OMNIROUTE_MODELS: comma list of requested-id=expected-reported-id pairs, e.g. provider/model=model.
OMNIROUTE_ENABLED=0
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=
OMNIROUTE_LOGGING_DISABLED_CONFIRMED=0
COVERGUIDE_LOCAL_OMNIROUTE_PILOT_ACK=0
OMNIROUTE_MODELS=gemini/gemini-3.5-flash-lite=gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite=gemini-3.1-flash-lite
# Interactive v2 roles only, e.g. omniroute:provider/model (must be listed in OMNIROUTE_MODELS).
COVERGUIDE_CUSTOMER_INTERPRETATION_ROUTE=omniroute:gemini/gemini-3.5-flash-lite
COVERGUIDE_FINAL_EXPLANATION_ROUTE=omniroute:gemini/gemini-3.5-flash-lite

# Generate independent 32-byte values and encode them with base64url. Keep old entries
# after a comma during key rotation; the first entry is used for new ciphertexts/commitments.
COVERGUIDE_ENCRYPTION_KEYS=v1:replace-with-base64url-encoded-32-byte-key
COVERGUIDE_COMMITMENT_KEYS=v1:replace-with-a-different-base64url-encoded-32-byte-key
# Keep the greenfield replacement separate from any legacy pilot runtime tree.
COVERGUIDE_V2_STORAGE_ROOT=/absolute/path/to/health-insurance-agent/data/v2-closeout
COVERGUIDE_MANIFEST_ROOT=/absolute/path/to/health-insurance-agent/data/manifests
COVERGUIDE_REPORT_ROOT=/absolute/path/to/health-insurance-agent/data/reports
