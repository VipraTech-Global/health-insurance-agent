components:
  schemas:
    Account:
      type: object
      properties:
        provider:
          type: string
        label:
          type: string
        state:
          type: string
        masked_identifier:
          type: string
        has_active_account:
          type: boolean
        can_restore:
          type: boolean
        login_in_progress:
          type: boolean
        action_required:
          type: boolean
      required:
      - action_required
      - can_restore
      - has_active_account
      - label
      - login_in_progress
      - masked_identifier
      - provider
      - state
    AccountAction:
      type: object
      properties:
        action:
          $ref: '#/components/schemas/ActionEnum'
      required:
      - action
    AccountActionResult:
      type: object
      properties:
        account:
          $ref: '#/components/schemas/Account'
        provider:
          type: string
        authorization_url:
          type: string
          format: uri
        expires_at:
          type: integer
    ActionEnum:
      enum:
      - connect
      - status
      - cancel
      - disconnect
      - restore
      - forget
      type: string
      description: |-
