        adapter_version:
          type: string
          maxLength: 120
        route_configuration_sha256:
          type: string
          maxLength: 64
        schema_sha256:
          type: string
          maxLength: 64
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - adapter_version
      - created_at
      - endpoint_profile
      - expected_model
      - observed_model
      - qualification_id
      - requested_model
      - role
      - route_configuration_sha256
      - route_id
      - schema_sha256
